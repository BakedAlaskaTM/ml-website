# Supabase project → Settings → Database → Connection string
# Use the pooled connection string for DATABASE_URL and direct connection for DIRECT_URL.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Create a Discord application and add this OAuth2 redirect URL:
# http://localhost:3000/api/auth/callback/discord
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
